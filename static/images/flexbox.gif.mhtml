ntcolor; border-image: none; border-radius: 4px; font-family: "PT Sans", sa=
ns-serif; font-size: 16px; line-height: 24px; color: rgb(255, 255, 255); cu=
rsor: pointer; user-select: none; appearance: none; }

button:active { outline: none; }

