us: 4px 0px 0px 4px; }

.arrow.right { border-left: 1px solid rgba(255, 255, 255, 0.2); border-radi=
us: 0px 4px 4px 0px; }

.arrow.left:not(.disabled):hover, .arrow.right:not(.disabled):hover { borde=
r-color: transparent; }

.arrow.disabled { opacity: 0.5; }

